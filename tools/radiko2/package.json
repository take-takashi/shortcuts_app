{
  "name": "radiko2",
  "version": "1.0.0",
  "private": true,
  "description": "radikoのタイムフリー番組をキーワードで自動ダウンロードするCLI",
  "main": "src/index.ts",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "bun build --compile --target=bun-darwin-arm64 src/download.ts --outfile dist/radiko2",
    "download": "bun src/download.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fast-xml-parser": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.3"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
