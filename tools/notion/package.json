{
  "name": "notion-tools",
  "version": "1.0.0",
  "private": true,
  "description": "Notion APIとファイルアップロードを扱う共通Bunライブラリ",
  "main": "src/index.ts",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile src/cli.ts --outfile dist/notion"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.3"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
