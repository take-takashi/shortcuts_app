{
  "$schema": "https://json.schemastore.org/tsconfig",
  "include": ["src/**/*.ts", "tests/**/*.ts", "../../download_radiko_and_upload_notion.ts"],
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "target": "ES2023",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["bun", "node"],
    "noEmit": true
  }
}
